{
  "name": "@0al/agent-surface",
  "version": "0.1.0-experimental.0",
  "description": "Experimental Agent Surface Protocol SDK for Node.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0al-spec/agent-surface-js.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "spec-lock.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "import": "./dist/authoring/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check . && tsc --noEmit && vitest run && npm run test:hello-consumer && npm run test:action-authoring-prototype && npm run test:authoring-consumer && npm run test:proposal-exchange",
    "test": "vitest run",
    "prepack": "npm run build",
    "test:hello-consumer": "node scripts/test-hello-consumer.mjs",
    "build:action-authoring-prototype": "npm run build && tsc -p experiments/offline-action-authoring/tsconfig.build.json",
    "test:action-authoring-prototype": "npm run build:action-authoring-prototype && node scripts/test-action-authoring-prototype.mjs",
    "test:authoring-consumer": "npm run build && node scripts/test-authoring-consumer.mjs",
    "build:proposal-exchange": "npm run build && tsc -p experiments/offline-proposal-exchange/tsconfig.build.json",
    "test:proposal-exchange": "npm run build:proposal-exchange && node scripts/test-proposal-exchange-consumer.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "canonicalize": "4.0.0",
    "jsonc-parser": "3.3.1"
  },
  "peerDependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "peerDependenciesMeta": {
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@sinclair/typebox": "0.34.52",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.1"
  }
}
